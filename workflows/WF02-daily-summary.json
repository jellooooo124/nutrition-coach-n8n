      "id": "592cb76d-9102-4659-84e2-b05854174909",
      "name": "讀取現有日總結避免覆寫已審核文字",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const clients=$('讀取所有 Clients').all().map(i=>i.json),meals=$('讀取所有 Meals').all().map(i=>i.json),existing=new Set($input.all().map(i=>String(i.json.summary_id||'')));\nconst iso=d=>d.toISOString().slice(0,10);const yday=iso(new Date(Date.now()+8*3600000-86400000));\nconst result=[];\nfor(const c of clients){\n if(!String(c.client_id||'').startsWith('TEST-'))continue;\n if(String(c.active||'').trim()!=='是'||!c.client_id||yday<String(c.course_start||'9999')||yday>String(c.course_end||'0000')) continue;\n const id='DAY|'+c.client_id+'|'+yday;if(existing.has(id))continue;\n const eligible=meals.filter(r=>String(r.client_id)===String(c.client_id)&&String(r.meal_date)===yday);const m=[...new Map(eligible.map(r=>[String(r.meal_date)+'|'+String(r.meal_type),r])).values()];\n const unique=new Set(m.map(r=>r.meal_type));const expected=Math.max(0,Number(c.daily_expected_meals)||0);const target=Math.max(0,Number(c.daily_target_goal_meals)||0);\n const yes=m.filter(r=>String(r.coach_goal_met).trim()==='是').length,no=m.filter(r=>String(r.coach_goal_met).trim()==='否').length;\n const cov=expected?Math.min(100,Math.round(unique.size/expected*100)):'';\n const goalPct=target&&yes+no?Math.min(100,Math.round(yes/target*100)):'';\n const dayNo=Math.round((new Date(yday+'T00:00:00Z')-new Date(String(c.course_start).slice(0,10)+'T00:00:00Z'))/86400000);const week=Math.floor(dayNo/7)+1;\n const note=(unique.size<expected?'此日記錄未完整，':'')+(!target?'未設定可量化的個別目標；':yes+no===0?'教練尚未核實是否符合目標；':'目標進度僅依教練核實資料計算，非健康成果。');\n const details=m.map(r=>[r.meal_type,'描述:'+String(r.meal_text||r.observed_foods||'沒有可核實內容'),'AI 目標關聯:'+String(r.goal_alignment||'資料不足'),'教練核實:'+String(r.coach_goal_met||'待確認')].join(' / ')).join('\\n');\n const prompt=['你是營養教練的內部助理，使用繁體中文。請根據'+yday+'一整天的餐點資料寫客製化日總結，個案第'+week+'週。','個人八週目標：'+String(c.goal_text||''),'追蹤指標：'+String(c.goal_rule||''),'記錄覆蓋率：'+String(cov === '' ? '無法計算' : cov)+'%；依人工核實的目標進度：'+String(goalPct === '' ? '無法計算' : goalPct)+'%。'+note,'記錄：\\n'+(details||'無上傳'), '嚴禁把缺漏推論為沒吃或目標失敗；不推測體重/疾病/血糖，並指出資訊不足。輸出 coach_summary 給教練、ai_client_draft 給客戶約100-160字可複製貼回平台、鼓勵下一步。'].join('\\n');\n result.push({json:{summary_id:id,client_id:c.client_id,report_date:yday,course_week:String(week),goal_text:c.goal_text||'',expected_meals:String(expected),recorded_meals:String(unique.size),coverage_pct:String(cov),daily_target_goal_meals:String(target),verified_goal_yes:String(yes),verified_goal_no:String(no),goal_achievement_pct:String(goalPct),metric_note:note,requestBody:{contents:[{parts:[{text:prompt}]}],generationConfig:{responseMimeType:'application/json',responseJsonSchema:{type:'object',properties:{coach_summary:{type:'string'},ai_client_draft:{type:'string'}},required:['coach_summary','ai_client_draft']}}}}});\n}\nreturn result;",
        "mode": "runOnceForAllItems"
      },

      "id": "cdade94a-1e2b-4629-ba9b-b4762a6e5eea",
      "name": "Gemini 撰寫日總結",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const from=$('建構日總結分析素材').all();\nreturn $input.all().map((i,index)=>{\n const original=from[index]?.json;if(!original)throw new Error('報表原始資料與 Gemini 回傳數量不一致');\n let obj={};try{obj=JSON.parse(String(i.json.candidates?.[0]?.content?.parts?.[0]?.text??'').replace(/^```(?:json)?\\s*/i,'').replace(/```\\s*$/,'').trim())}catch(e){throw new Error('總結 AI JSON 解析失敗：'+e.message)}\n let draft=String(obj.ai_client_draft??'');\n const unsafe=/(符合.{0,30}目標|達成率|達標|落實|感受身體|全部.{0,10}達|每天.{0,20}都|連續.{0,15}攝取|達成.{0,15}目標|成功達|已達標|專屬營養輔助 AI)/.test(draft);\n const period=original.report_date||String(original.week_start)+' 至 '+String(original.week_end);\n const coverage=original.coverage_pct===''?'無法計算':original.coverage_pct+'%';\n const target=original.daily_target_goal_meals||original.goal_target_total;\n const facts=period+'：目前收到 '+original.recorded_meals+' 餐紀錄，約定記錄 '+original.expected_meals+' 餐，記錄覆蓋率 '+coverage+'。教練已核實符合習慣指標的紀錄有 '+original.verified_goal_yes+' 餐；'+(original.goal_achievement_pct===''?'目前無法判定目標進度。':'相對設定的 '+target+' 餐目標，可核實進度為 '+original.goal_achievement_pct+'%。')+'未記錄或未核實的部分仍屬未知，這不是減脂或健康成果評分。';\n if(unsafe)draft='接下來可以從方便記錄的一餐開始，補充食物內容、實際份量及是否吃完；我們會依你的個人目標一起調整。';\n obj.ai_client_draft=facts+'\\n\\n'+draft;\n obj.coach_summary='[系統核對數據] '+facts+'\\n[AI 草稿，需人工核實] '+String(obj.coach_summary??'')+(unsafe?'\\n[輸出檢查] 客戶草稿中的過度肯定敘述已替換。':'');\n const {requestBody,...meta}=original;\n // 預設不寫入；準備好後由教練明確設定為 false。\n const PREVIEW_ONLY=true;\n return {json:{...meta,coach_summary:String(obj.coach_summary??''),ai_client_draft:String(obj.ai_client_draft??''),approved_text:'',review_status:'待教練審核',manually_replied_at:'',created_at:new Date().toISOString(),allow_write:!PREVIEW_ONLY}};\n});",
        "mode": "runOnceForAllItems"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1710,
        20
      ],

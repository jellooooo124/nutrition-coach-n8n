    {
      "parameters": {
        "jsCode": "const context=$('結合客戶目標及餐點').itemMatching(0).json;\nconst base64=String($input.first().json.image_base64??'');\nif(!base64) throw new Error('Google Drive 檔案沒有產生 image_base64');\nconst mime=base64.startsWith('iVBORw0KGgo')?'image/png':base64.startsWith('UklGR')?'image/webp':'image/jpeg';\nconst schema={type:'object',properties:{observed_foods:{type:'string'},goal_alignment:{type:'string'},ai_coach_assessment:{type:'string'},missing_info:{type:'string'},ai_client_draft:{type:'string'},issue_flags:{type:'string'}},required:['observed_foods','goal_alignment','ai_coach_assessment','missing_info','ai_client_draft','issue_flags']};\nreturn [{json:{requestBody:{contents:[{parts:[{text:context.analysis_prompt},{inline_data:{mime_type:mime,data:base64}}]}],generationConfig:{responseMimeType:'application/json',responseJsonSchema:schema}}}}];",

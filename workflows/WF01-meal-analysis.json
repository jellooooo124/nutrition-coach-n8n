    {
      "parameters": {
        "jsCode": "return $input.all().map((item,index)=>{\nconst raw=item.json;\nconst s=v=>String(v??'').trim();\nconst id=s(raw.submission_id), client=s(raw.client_id), date=s(raw.meal_date).slice(0,10);\nconst parsed=new Date(date+'T00:00:00Z');\nconst dateValid=Number.isFinite(parsed.getTime())&&parsed.toISOString().slice(0,10)===date;\nconst valid=client.startsWith('TEST-')&&dateValid&&/^[A-Za-z0-9_-]{3,80}$/.test(id)&&/^[A-Za-z0-9_-]{3,80}$/.test(client)&&/^\\d{4}-\\d{2}-\\d{2}$/.test(date)&&!!s(raw.meal_type)&&(!!s(raw.meal_text)||!!s(raw.photo_drive_url));\nconst u=s(raw.photo_drive_url);let photoFileId='';\nif(u){let m=u.match(/\\/d\\/([A-Za-z0-9_-]{15,})/)||u.match(/[?&]id=([A-Za-z0-9_-]{15,})/)||u.match(/(?:^|\\s)([A-Za-z0-9_-]{25,})(?:\\s|$)/); photoFileId=m?m[1]:'';}\nconst validPhoto=!u||!!photoFileId;\nreturn {pairedItem:{item:index},json:{...raw,submission_id:id,client_id:client,meal_date:date,photo_file_id:photoFileId,valid:valid&&validPhoto,error:!valid?'缺少有效的 submission_id、client_id、meal_date、meal_type 或文字／照片':(!validPhoto?'照片必須是可讀取的 Google Drive 檔案連結':'')}};\n});",

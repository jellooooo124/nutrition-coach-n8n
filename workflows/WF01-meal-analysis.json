      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const orig=$('結合客戶目標及餐點').itemMatching(0).json;\nlet ai={},error='';\ntry { const text=String($input.first().json.candidates?.[0]?.content?.parts?.[0]?.text??'').replace(/^```(?:json)?\\s*/i,'').replace(/```\\s*$/,'').trim(); ai=JSON.parse(text); }\ncatch(e){error='Gemini 回傳格式無法解析：'+e.message;}\nconst clean=v=>String(v??'').replace(/\\\\n/g,'\\n').trim();\nconst output={submission_id:orig.submission_id,client_id:orig.client_id,meal_date:orig.meal_date,meal_type:orig.meal_type,meal_text:orig.meal_text??'',photo_drive_url:orig.photo_drive_url??'',ate_all:orig.ate_all??'',portion_notes:orig.portion_notes??'',client_goal:orig.client_goal,\n observed_foods:clean(ai.observed_foods),goal_alignment:clean(ai.goal_alignment)||'資料不足',ai_coach_assessment:clean(ai.ai_coach_assessment),missing_info:clean(ai.missing_info),ai_client_draft:clean(ai.ai_client_draft),coach_approved_text:'',coach_goal_met:'待確認',review_status:'待教練審核',manually_replied_at:'',processing_status:error?'AI錯誤_需人工處理':'AI草稿待教練審核',issue_flags:clean(ai.issue_flags)+(error?'\\n'+error:''),created_at:new Date().toISOString()};\nconst unsupported=/(達成|達標|落實|做到|完成|符合.{0,15}目標|完美|每天.{0,20}都)/.test(output.ai_client_draft);\nif(unsupported){\n output.ai_coach_assessment+='\\n[輸出檢查] 原始客戶草稿含未經人工核實的達標敘述，已改為保守回饋。';\n output.ai_client_draft='已收到這餐紀錄。針對你設定的「'+orig.client_goal+'」，下次可以補充與目標相關的食物、實際吃了多少，以及是否吃完，讓我們更清楚追蹤進度。這次紀錄是否符合目標，仍需由教練核實；照片或文字中出現某項食物，不代表已確認實際攝取量。';\n output.issue_flags+='\\nunsupported_goal_claim_replaced';\n}\n// 先只預覽；確認資料權限及測試後，將此行改成 false 才能寫入測試表。\nconst PREVIEW_ONLY=true;\nreturn [{json:{...output,allow_write:!PREVIEW_ONLY&&!error&&!!output.ai_client_draft}}];",

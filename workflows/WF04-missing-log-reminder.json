      "name": "讀取現有提醒避免重複",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const clients=$('讀取追蹤中 Clients').all().map(x=>x.json),meals=[...$('讀取 Meals').all(),...$('讀取尚待分析的 Meal_Intake').all()].map(x=>x.json),old=new Set($input.all().map(x=>String(x.json.reminder_id??'')));\nconst today=new Date(Date.now()+8*3600000).toISOString().slice(0,10);\nconst output=[];\nfor(const c of clients){\n if(!String(c.client_id||'').startsWith('TEST-'))continue;\n if(String(c.active||'').trim()!=='是'||!c.client_id||today<String(c.course_start||'9999')||today>String(c.course_end||'0000'))continue;\n const found=meals.some(m=>String(m.client_id)===String(c.client_id)&&String(m.meal_date)===today);\n const id='NOLOG|'+c.client_id+'|'+today;if(found||old.has(id))continue;\n const goal=String(c.goal_text||'逐步建立自己的飲食習慣').trim();\n const draft='嗨！今天截至目前還沒看到你的飲食紀錄 😊 有空的話可以補上一張餐點照片或簡單文字，讓我們一起持續追蹤「'+goal+'」的進展。若今天比較忙也沒關係，方便時再補充就好！';\n const PREVIEW_ONLY=true;\n output.push({json:{reminder_id:id,client_id:c.client_id,reminder_date:today,goal_text:goal,reason:'截至提醒時間沒有今日餐點紀錄',ai_draft:draft,approved_text:'',review_status:'待教練審核',manually_sent_at:'',created_at:new Date().toISOString(),allow_write:!PREVIEW_ONLY}});\n}\nreturn output;",
        "mode": "runOnceForAllItems"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        0
      ],
